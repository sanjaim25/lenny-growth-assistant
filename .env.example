# Database Connection
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/growth_assistant

# Ollama Connectivity
# host.docker.internal resolves to the host machine running Docker
# This allows the container to talk to the local Ollama instance
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Optional: Claude Agent SDK API Key (Not needed for local demo mode)
# ANTHROPIC_API_KEY=sk-ant-api03...

# Frontend to Backend URL
NEXT_PUBLIC_API_URL=http://localhost:8000
