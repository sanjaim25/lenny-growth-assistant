# Database Connection
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/growth_assistant

# Ollama Connectivity
# host.docker.internal resolves to the host machine running Docker
# This allows the container to talk to the local Ollama instance
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Model Selection
# Default local demo mode uses gpt-4o-mini which maps to local-llama in LiteLLM
MODEL_ID=gpt-4o-mini
# To use Claude, uncomment below and ensure ANTHROPIC_API_KEY is set:
# MODEL_ID=claude-3-5-sonnet

# Optional: Claude API Key
# ANTHROPIC_API_KEY=sk-ant-api03...

# Optional: Groq API Key
# GROQ_API_KEY=gsk_...

# Frontend to Backend URL
NEXT_PUBLIC_API_URL=http://localhost:8000
